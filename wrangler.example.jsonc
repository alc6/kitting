// Template for wrangler.jsonc. Copy it (`cp wrangler.example.jsonc wrangler.jsonc`)
// and replace every placeholder, or let `npm run config` / the deploy workflow
// generate wrangler.jsonc from environment variables.
// The real wrangler.jsonc is gitignored: never commit account-specific values.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kitting",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// Never expose the Worker on *.workers.dev or preview URLs:
	// Cloudflare Access only protects the custom domain below.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "kitting.example.com", "custom_domain": true }],
	"assets": { "directory": "./public" },
	// Builds public/static/app.css (Tailwind) before `wrangler dev` and `wrangler deploy`,
	// and again whenever a file under src/ changes during `wrangler dev`.
	"build": { "command": "npm run css", "watch_dir": "src" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kitting",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	// Optional: product images, stored in an R2 bucket. Create it once with
	// `npx wrangler r2 bucket create kitting-images`. Without this binding the app runs without images.
	// The deploy workflow adds it only when the IMAGES_BUCKET variable is set.
	"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "kitting-images" }],
	// Optional: the MCP server for AI assistants (OAuth clients, grants and tokens live in this KV namespace).
	// Create it once with `npx wrangler kv namespace create OAUTH_KV` and put its id here. Without this binding
	// /mcp and the OAuth routes answer 404. The deploy workflow adds it only when the OAUTH_KV_ID variable is set.
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
	"vars": {
		"ENVIRONMENT": "production",
		// Your Zero Trust team domain, e.g. "acme.cloudflareaccess.com".
		"TEAM_DOMAIN": "your-team.cloudflareaccess.com",
		// "Application Audience (AUD) Tag" of the Access application.
		"ACCESS_AUD": "replace-with-your-access-aud-tag",
		// Comma-separated emails allowed to import, delete and archive.
		"ADMIN_EMAILS": "admin@example.com",
		// "en" or "fr".
		"DEFAULT_LOCALE": "en",
		// ISO 4217 code used to display money.
		"CURRENCY": "EUR",
		// Only honoured when ENVIRONMENT is "development". Leave empty in production.
		"DEV_AUTH_EMAIL": ""
	},
	"observability": { "enabled": true }
}
