{
	"name": "kitting",
	"version": "0.4.0",
	"private": true,
	"description": "Lightweight mini-MRP for small hardware makers, on Cloudflare Workers + D1 + Access.",
	"license": "MIT",
	"type": "module",
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "1.2.3",
		"@modelcontextprotocol/server": "2.3.1",
		"drizzle-orm": "0.45.4",
		"hono": "4.13.13",
		"jose": "6.2.12",
		"lucide": "1.55.0",
		"tailwind-merge": "3.7.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@cloudflare/vitest-plugin": "1.4.0",
		"@cloudflare/workers-types": "5.20261012.1",
		"@tailwindcss/cli": "4.3.3",
		"drizzle-kit": "0.31.11",
		"htmx.org": "2.0.11",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vitest": "4.1.11",
		"wrangler": "4.149.0"
	},
	"scripts": {
		"dev": "npm run css && wrangler dev",
		"deploy": "npm run css && wrangler d1 migrations apply DB --remote && wrangler deploy",
		"config": "node scripts/gen-wrangler-config.mjs",
		"release:bundle": "node scripts/build-release.mjs",
		"db:generate": "drizzle-kit generate",
		"db:triggers": "node scripts/history-triggers.mjs",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"cf-typegen": "wrangler types --config wrangler.example.jsonc --include-runtime=false --strict-vars=false",
		"css": "tailwindcss -i src/styles/app.css -o public/static/app.css --minify",
		"css:watch": "tailwindcss -i src/styles/app.css -o public/static/app.css --watch",
		"skill:zip": "node scripts/pack-skill.mjs",
		"vendor:htmx": "cp node_modules/htmx.org/dist/htmx.min.js public/static/htmx.min.js",
		"typecheck": "tsc -p .",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:scripts": "node --test scripts/tests/*.node.mjs",
		"check": "npm run css && npm run typecheck && npm run lint && npm run test && npm run test:scripts"
	},
	"engines": {
		"node": ">=20"
	}
}
